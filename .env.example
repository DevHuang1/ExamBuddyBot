TELEGRAM_BOT_TOKEN=
# Owner-only deployment secret. Students never provide an API key.
GROQ_API_KEY=

# Optional
# PORT=8080
# TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# ANSWER_MODEL=openai/gpt-oss-120b
# VISION_MODEL=qwen/qwen3.6-27b
# ANSWER_TEMPERATURE=0.15
# MAX_COMPLETION_TOKENS=4096
# MAX_SOURCE_CHARS=20000
# MAX_UPLOAD_BYTES=12582912
# MAX_STORED_SOURCE_BYTES=31457280
# MAX_IMAGE_BYTES=6291456
# MAX_TEXT_QUESTION_CHARS=6000
# MAX_SOURCES_PER_CHAT=12
# MAX_SCANNED_PDF_PAGES=15
# PDF_RENDER_DPI=160
# REQUEST_TIMEOUT_MS=60000
# HEALTH_STALE_AFTER_MS=90000
# Per-study-workspace model calls allowed within one rolling time window.
# MAX_MODEL_REQUESTS_PER_WINDOW=12
# MODEL_REQUEST_WINDOW_SECONDS=60
# HF_RETRIEVAL_ENABLED=true
# Owner-only Hugging Face token with Inference Providers permission. Without it, local fuzzy semantic retrieval remains active.
# HF_TOKEN=
# HF_EMBEDDING_MODEL=thenlper/gte-large
# HF_INFERENCE_PROVIDER=hf-inference
# Set false to use lexical retrieval only when remote embeddings are unavailable.
# FUZZY_RETRIEVAL_FALLBACK_ENABLED=true
# SOURCES_FILE=
# QUIZ_PERFORMANCE_FILE=
# QUIZ_MISTAKES_FILE=
# FLASHCARD_SETS_FILE=
# STUDY_GUIDES_FILE=
# Maximum recent missed source-grounded quiz questions retained per learner workspace.
# MAX_RETAINED_QUIZ_MISTAKES=10
# UPDATE_OFFSET_FILE=
# DATA_DIR=
